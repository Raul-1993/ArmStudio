{"Name":"Contorno de práctica","Source":"! ARM STUDIO · Práctica de trayectoria\r\n! Posiciones simuladas en mm y grados.\r\nMODULE Practice\r\n    PROC main()\r\n        MoveL pHome, v50, fine, tool0;\r\n        MoveL p1, v50, fine, tool0;\r\n        MoveC pVia, p2, v50, z0, tool0;\r\n        MoveL p3, v50, fine, tool0;\r\n        WaitTime 0.5;\r\n        MoveL pHome, v50, fine, tool0;\r\n    ENDPROC\r\nENDMODULE\r\n","Points":[{"Name":"pHome","Pose":{"X":0,"Y":0,"Z":200,"A":0,"B":0,"C":0}},{"Name":"p1","Pose":{"X":120,"Y":0,"Z":200,"A":0,"B":0,"C":0}},{"Name":"pVia","Pose":{"X":150,"Y":30,"Z":200,"A":0,"B":0,"C":0}},{"Name":"p2","Pose":{"X":120,"Y":60,"Z":200,"A":0,"B":0,"C":0}},{"Name":"p3","Pose":{"X":0,"Y":60,"Z":200,"A":0,"B":0,"C":0}}]}